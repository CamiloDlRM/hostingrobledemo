# Database
DATABASE_URL=postgresql://deployuser:deploypass@db:5432/deployments_db

# GitHub App
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.xxxxx
GITHUB_CLIENT_SECRET=xxxxx
GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Docker Hub
DOCKER_HUB_USERNAME=your-username
DOCKER_HUB_PASSWORD=your-password
DOCKER_HUB_REPO=your-username/deployments

# Server SSH
SERVER_SSH_HOST=your-server.com
SERVER_SSH_USER=deploy
SERVER_SSH_KEY_PATH=/path/to/ssh-key

# Domain
DOMAIN_BASE=hostingroble.com

# App
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Security
SECRET_KEY=your-secret-key-change-this-in-production
